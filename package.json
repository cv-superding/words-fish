{
  "name": "words-fish",
  "version": "1.2.3",
  "description": "摸鱼背单词 - Windows 桌面碎片化英语单词记忆工具（托盘通知 + 全局快捷键悬浮窗）",
  "main": "src/main/main.js",
  "author": "cv-superding",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cv-superding/words-fish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cv-superding/words-fish.git"
  },
  "bugs": {
    "url": "https://github.com/cv-superding/words-fish/issues"
  },
  "scripts": {
    "pack": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.wordsfish.app",
    "productName": "WordsFish",
    "copyright": "Copyright © 2026 cv-superding",
    "asar": true,
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "dir",
      "artifactName": "${productName}.${ext}",
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "app-v19",
      "buildResources": "assets"
    }
  }
}
